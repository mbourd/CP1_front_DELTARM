    "diff": "^4.0.2",
    "dompurify": "^3.0.9",
    "draft-convert": "^2.1.12",
    "draft-js": "^0.11.7",
    "i18next": "^19.8.3",
    "i18next-browser-languagedetector": "^6.1.4",
    "i18next-http-backend": "^1.4.1",
    "jodit-react": "^4.0.18",
    "jwt-decode": "^3.0.0",
    "localforage": "^1.9.0",
    "lodash": "^4.17.20",
    "lz-string": "^1.5.0",
    "mathjs": "^11.8.2",
    "qs": "^6.9.4",
    "randexp": "^0.5.3",
    "react": "18.2.0",
    "react-app-polyfill": "^3.0.0",
    "react-data-grid": "^7.0.0-beta.12",
    "react-dom": "18.2.0",
    "react-draft-wysiwyg": "^1.14.7",
    "react-dropzone": "^11.5.3",
    "react-hook-form": "6",
