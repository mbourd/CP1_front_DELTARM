    "react-idle-timer": "^4.5.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "5.0.1",
    "react-virtualized": "^9.22.3",
    "recoil": "^0.7.7",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.1.8",
    "superagent": "^8.1.2"
