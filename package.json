{
  "name": "cp1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "yarn lint && yarn lint:style && DISABLE_ESLINT_PLUGIN=true react-scripts start",
    "start:browser:none": "yarn lint && yarn lint:style && BROWSER=none DISABLE_ESLINT_PLUGIN=true react-scripts start",
    "build": "react-scripts --max_old_space_size=4096 build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prettier": "prettier './src/**/*.{ts,tsx}' --check",
    "prettier:fix": "prettier --single-quote --print-width 80 --trailing-comma all --write './src/**/*.{ts,tsx}'",
    "lint:all": "yarn lint && yarn lint:cypress && yarn lint:jest && yarn lint:style",
    "lint": "eslint ./src --ext .ts,.tsx --ignore-pattern '**/*.cy.ts' --ignore-pattern '**/*.cy.tsx' --ignore-pattern '**/*.test.ts' --config .eslintrc",
    "lint:cypress": "eslint './cypress/support/*.ts' '**/*.cy.{ts,tsx}' --config .eslintrc",
    "lint:jest": "eslint '**/*.test.{ts,tsx}' --config .eslintrc",
    "lint:fix": "eslint ./src --ext .ts,.tsx --ignore-pattern '**/*.cy.ts' --ignore-pattern '**/*.cy.tsx' --config .eslintrc --fix",
    "lint:style": "stylelint './src/**/*.{ts,tsx}'",
    "lint:style:fix": "stylelint './src/**/*.{ts,tsx}' --fix",
    "cypress:install": "cypress install",
    "cypress:open": "yarn lint:cypress && DISABLE_ESLINT_PLUGIN=true cypress open",
    "cypress:open:debug:all": "DEBUG=cypress:* cypress open",
    "cypress:info": "cypress info",
    "cypress:run:e2e": "cypress run --e2e",
    "cypress:run:e2e:chrome": "cypress run --e2e --browser chrome",
    "cypress:run:e2e:firefox": "cypress run --e2e --browser firefox",
    "cypress:run:component": "cypress run --component",
    "cypress:parallel:component:chrome": "cypress-parallel -s cypress:run:component:chrome:ci -m false",
    "cypress:run:component:chrome": "cypress run --component --browser chrome",
    "cypress:run:component:chrome:ci": "DISABLE_ESLINT_PLUGIN=true cypress run --component --browser chrome --headless --config video=false,screenshotOnRunFailure=false,experimentalMemoryManagement=true,numTestsKeptInMemory=0",
    "cypress:run:component:firefox": "cypress run --component --browser firefox",
    "cypress:cache:clear": "cypress cache clear",
    "cypress:cache:prune": "cypress cache prune"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "eslintConfig": {
    "extends": "react-app",
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version"
    ]
  },
  "dependencies": {
    "@emotion/core": "^11.0.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^2.8.0",
    "@mui/icons-material": "^5.15.14",
    "@mui/lab": "^5.0.0-alpha.169",
    "@mui/material": "^5.15.14",
