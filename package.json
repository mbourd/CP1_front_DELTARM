{
  "name": "cp1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prettier:fix": "prettier --single-quote --print-width 80 --trailing-comma all --write './src/**/*.{ts,tsx}'",
    "lint": "eslint ./src --ext .tsx --config .eslintrc",
    "lint:fix": "eslint ./src --ext .tsx --config .eslintrc --fix",
    "lint:style": "stylelint './src/**/*.{ts,tsx}'",
    "lint:style:fix": "stylelint './src/**/*.{ts,tsx}' --fix",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "eslintConfig": {
    "extends": "react-app",
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version"
    ]
  },
  "dependencies": {
    "@emotion/core": "^11.0.0",
